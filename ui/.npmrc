# The lint toolchain inherited from antora-ui-default has unsatisfiable peer
# ranges under npm 7+ (eslint-config-standard@16 wants eslint 7 but eslint 8 is
# pinned; gulp-stylelint@13 wants stylelint 13 but stylelint 14 is pinned).
# These are lint-only dev dependencies and do not affect the built bundle, so
# the peer graph is relaxed rather than chased upstream. Without this, a plain
# `npm install` on a clean checkout fails outright.
legacy-peer-deps=true
